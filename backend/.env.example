# Copiar a backend/.env y ajustar si hace falta:
#   cp backend/.env.example backend/.env
#
# ⚠️ El backend carga este archivo con `import 'dotenv/config'`, que resuelve
# la ruta desde el CWD. Hay que arrancarlo siempre desde backend/:
#   cd backend && npm run dev

# ── Base de datos ──
# MySQL 8 en Docker (docker-compose.yml en la raíz del repo).
# Puerto 3309 para no chocar con otros proyectos en la misma máquina.
# Estas credenciales son de desarrollo local y coinciden con los defaults
# del docker-compose — no son secretos.
DB_HOST=127.0.0.1
DB_PORT=3309
DB_USER=unclick_user
DB_PASS=unclick_local
DB_NAME=unclik

# ── Servidor ──
# 3001 lo ocupa wa-sender en algunas máquinas; UNCLICK usa 3002.
PORT=3002

# ── App ──
# URL del frontend (para CORS y enlaces dentro de los correos).
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ── Rate limiting ──
# Valores holgados para desarrollo. En producción se omiten estas variables
# y aplican los defaults del código, que son los estrictos.
# Sin esto, navegar el panel admin agota el presupuesto de /api/v1/auth
# (que cubre /me y /profile/counts) y bloquea el login por 15 minutos.
RATE_LIMIT_AUTH_MAX=1000
RATE_LIMIT_UPLOAD_MAX=1000
RATE_LIMIT_PUBLICO_MAX=5000
RATE_LIMIT_GENERAL_MAX=10000

# ── Email (Gmail) — opcional en dev ──
# Solo se necesita para recuperación de contraseña. Sin credenciales, el envío
# falla en silencio (la API responde 200 igual, por anti-enumeración).
# Para probar el flujo sin SMTP: leer el token de tb_password_reset_tokens y
# abrir http://localhost:5173/?reset=<token>
# Usar una App Password de Gmail, no la contraseña de la cuenta.
EMAIL_USER=
EMAIL_PASS=
