# ── Base de datos ──
# Por defecto: contenedor Docker `unclick-mysql` (MySQL 8) en 3309 — ver docker-compose.yml
#   docker compose up -d && cd backend && npm run db:setup
# Alternativa legacy (XAMPP MariaDB): DB_PORT=3308, DB_USER=root, DB_PASS= (sin password)
# ADVERTENCIA: estas credenciales son SOLO para el contenedor local de desarrollo.
# Producción y staging usan credenciales distintas, gestionadas fuera del repo.
DB_HOST=127.0.0.1
DB_PORT=3309
DB_USER=unclick_user
DB_PASS=unclick_pass
DB_NAME=unclik

# ── Servidor ──
# Puerto 3001 lo ocupa wa-sender (PM2). UNCLICK usa 3002 en local.
PORT=3002

# ── QA local (opcional) ──
# true = desactiva bloqueo por intentos fallidos + rate-limit de /auth (QA sin fricción).
# Dejar SIEMPRE en false/ausente en prod y stage (es protección anti-fuerza-bruta).
AUTH_LOCKOUT_DISABLED=false

# ── App ──
# URL del frontend (para CORS y redirecciones de email)
APP_URL=http://localhost:5173
# Origen permitido en CORS — en producción cambiar a https://localclick.cl
CORS_ORIGIN=http://localhost:5173

# ── Email (Gmail) — opcional en dev ──
# Solo se necesita para recuperación de contraseña.
# Usar una App Password de Gmail (no la contraseña de la cuenta).
# Guía: https://support.google.com/accounts/answer/185833
EMAIL_USER=
EMAIL_PASS=
