# ── API ──
# En desarrollo con Vite proxy configurado (vite.config.js), dejar vacío.
# En producción, apuntar al backend: https://api.tusitio.cl
VITE_API=

# ── Sentry (opcional) ──
# DSN del proyecto en sentry.io — solo necesario en staging/producción.
# Sin este valor, Sentry no se inicializa (ver src/main.jsx).
VITE_SENTRY_DSN=
